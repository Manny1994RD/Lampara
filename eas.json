{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "ios-simulator": {
      "extends": "preview",
      "env": {
        "LAMPARA_IOS": "1"
      },
      "ios": {
        "simulator": true,
        "scheme": "Lampara"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "channel": "production"
    }
  }
}
